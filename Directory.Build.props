<Project>
  <PropertyGroup>
    <Version>1.0.0</Version>
    <!-- Each project names its own framework: set here, it would reach AberrationCalculator's projects too,
         and Visual Studio would then take its multi-targeted ones for net8.0 alone. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>Javier Ruiz, Claude Code</Authors>
    <Company>Javier Ruiz</Company>
    <Copyright>Copyright (c) 2026 Javier Ruiz and Claude Code</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <Description>General-purpose thermal analysis and athermalization of lenses: refractive index over temperature and pressure, expansion of elements and mounts, focus and image quality over a temperature range</Description>
  </PropertyGroup>
  <Import Project="AberrationCalculator.Location.props" />
</Project>
